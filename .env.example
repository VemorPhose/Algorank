APP_NAME=Algorank v2
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://algorank:algorank@postgres:5432/algorank
REDIS_URL=redis://redis:6379/0
JUDGE0_BASE_URL=http://judge0-server:2358
JWT_SECRET=change-me-in-development
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=20
REFRESH_TOKEN_EXPIRE_DAYS=30
BOOTSTRAP_ADMIN_EMAIL=admin@algorank.dev
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin
BOOTSTRAP_TOKEN=change-me-bootstrap
SUBMISSION_RATE_LIMIT=5
SUBMISSION_RATE_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=300
REGISTRATION_RATE_LIMIT=10
REGISTRATION_RATE_WINDOW_SECONDS=60
CACHE_DEFAULT_TTL_SECONDS=60
WORKER_ID=worker-local
WORKER_POLL_TIMEOUT_SECONDS=5
WORKER_MAX_ATTEMPTS=3
